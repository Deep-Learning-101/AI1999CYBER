# ================================
# 社群議題媒合系統 - 環境變數範本
# 複製此檔為 .env 並填入實際值
# ================================

# --- 資料庫 ---
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Neon:     postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- 管理員後台 ---
# 後台頁面路徑（越難猜越好，例如 dl101-x7k2m9）
# 存取網址：https://你的網域/${ADMIN_PATH}
ADMIN_PATH="your-secret-path-here"
# 用於保護 /api/admin/* 路由，請使用強隨機字串
ADMIN_SECRET_KEY="your-strong-random-secret-key"

# --- 外部通知 ---
# Google Apps Script Webhook（發送進度更新通知）
GAS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Resend（寄送 Magic Link 信件）—— 擇一使用
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# --- Next.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# --- 部署環境 ---
# Hugging Face Spaces 預設 7860；GCP Cloud Run 由平台注入 PORT
# 本地開發通常不需要設定此項
# PORT=7860
NODE_ENV="development"
